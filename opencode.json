{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4-flash",
  "default_agent": "orquestador",
  "agent": {
    "orquestador": {
      "description": "Orquestador principal (DeepSeek V4 Flash). Coordina, delega y consolida reportes. Prohibido bash.",
      "mode": "primary",
      "model": "opencode-go/deepseek-v4-flash",
      "prompt": "{file:.opencode/agents/orquestador.md}",
      "temperature": 0.5,
      "permission": {
        "edit": "allow",
        "bash": "deny",
        "task": "allow"
      },
      "color": "#2563eb"
    },
    "explorador": {
      "description": "Explora el código base para entender arquitectura, dependencias y flujos.",
      "model": "opencode-go/deepseek-v4-flash",
      "prompt": "{file:.opencode/agents/explorador.md}",
      "temperature": 0.1,
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow"
      }
    },
    "implementador": {
      "description": "Implementa cambios de código en Node.js/Express siguiendo las convenciones del proyecto.",
      "model": "opencode-go/deepseek-v4-flash",
      "prompt": "{file:.opencode/agents/implementador.md}",
      "temperature": 0.2,
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "read": "allow",
        "glob": "allow",
        "grep": "allow"
      }
    },
    "revisor": {
      "description": "Revisa código en busca de bugs, código muerto y malas prácticas.",
      "model": "opencode-go/deepseek-v4-flash",
      "prompt": "{file:.opencode/agents/revisor.md}",
      "temperature": 0.1,
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow"
      }
    },
    "diseniador": {
      "description": "Auditor UX/UI y diseño visual. Puede buscar referencias web.",
      "model": "opencode-go/deepseek-v4-flash",
      "prompt": "{file:.opencode/agents/diseniador.md}",
      "temperature": 0.1,
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "webfetch": "allow"
      }
    },
    "tester": {
      "description": "Ejecuta tests del proyecto. Por ahora sin framework configurado.",
      "model": "opencode-go/deepseek-v4-flash",
      "prompt": "{file:.opencode/agents/tester.md}",
      "temperature": 0.1,
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "read": "allow",
        "glob": "allow",
        "grep": "allow"
      }
    },
    "seguridad": {
      "description": "Auditor de seguridad OWASP, JWT, SQLi, XSS. Puede buscar vulnerabilidades online.",
      "model": "opencode-go/deepseek-v4-flash",
      "prompt": "{file:.opencode/agents/seguridad.md}",
      "temperature": 0.1,
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "webfetch": "allow"
      }
    },
    "documentador": {
      "description": "Crea y mantiene documentación del proyecto en archivos .md.",
      "model": "opencode-go/deepseek-v4-flash",
      "prompt": "{file:.opencode/agents/documentador.md}",
      "temperature": 0.2,
      "permission": {
        "edit": "allow",
        "bash": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow"
      }
    }
  }
}
