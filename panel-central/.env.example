# Copiá este archivo a .env y completá los valores reales.

# --- Servidor ---
PORT=4000
NODE_ENV=development

# --- Base de datos (proyecto de Neon PROPIO del Panel Central,
# separado de las bases de cada cliente) ---
# DATABASE_URL=postgresql://usuario:password@host/db?sslmode=require

DB_HOST=localhost
DB_PORT=5432
DB_NAME=panel_central
DB_USER=postgres
DB_PASSWORD=

# --- Autenticación del super-admin ---
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=8h
ADMIN_USERNAME=superadmin
ADMIN_PASSWORD=cambiar-por-una-contraseña-fuerte

# --- Sincronización con Lavadero360 (otro producto administrado desde este
# mismo Panel Central) --- Si se dejan vacías, los clientes producto=
# 'lavadero360' se guardan igual acá, pero no se sincroniza el corte/
# reactivación de acceso — hay que reintentarlo a mano después.
LAVADERO360_API_URL=http://localhost:3000
LAVADERO360_ADMIN_KEY=debe-coincidir-con-SUPERADMIN_API_KEY-de-lavadero360
