# Copiá este archivo a .env y completá los valores reales.
# Ver README.md para la tabla completa de variables de entorno.

# --- Servidor ---
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000

# --- Base de datos ---
# Opción A: producción (Neon u otro Postgres con connection string)
# DATABASE_URL=postgresql://usuario:password@host/db?sslmode=require

# Opción B: desarrollo local (variables individuales, se ignoran si DATABASE_URL está seteado)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=catalogo
DB_USER=postgres
DB_PASSWORD=

# Máximo de conexiones del pool (opcional)
# DB_POOL_MAX=10

# --- Autenticación ---
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=8h

# Credenciales del admin inicial (usadas solo por db-init.js la primera vez)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambiar-por-una-contraseña-fuerte

# --- CORS (solo se usa cuando NODE_ENV=production) ---
# CORS_ORIGIN=https://tu-dominio.com

# --- Imágenes de producto (ImageKit.io) ---
# Sin esto, subir una imagen por archivo desde el admin falla (a propósito —
# ver AUDITORIA.md, "El problema de las imágenes": el filesystem de Render es
# efímero, se borra en cada redeploy, así que no hay fallback silencioso a
# disco). Cargar una imagen por URL externa (POST .../images/url) sigue
# funcionando igual sin esto. Una sola cuenta de ImageKit sirve para todos
# los clientes — IMAGEKIT_FOLDER es lo que los separa dentro de la cuenta.
# Los 3 datos están en el dashboard de ImageKit, en "Developer options".
# IMAGEKIT_PUBLIC_KEY=tu-public-key
# IMAGEKIT_PRIVATE_KEY=tu-private-key
# IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/tu-id
# IMAGEKIT_FOLDER=catalogo

# --- Marca (opcional — si no se define, usa "PiezaExpress", la identidad de
# producto/demo con la que se vende el catálogo) ---
# Pensado para reusar el mismo código en varios clientes (ver AUDITORIA.md,
# "Multi-tenant"): cada deploy define su propia marca sin tocar código. El
# logo del header es el nombre en texto (ver STORE_NAME_ACCENT); STORE_LOGO_URL
# ahora solo se usa para el ícono de la pestaña del navegador.
# STORE_NAME=Repuestos Villalba
# STORE_NAME_ACCENT=Villalba
# STORE_TAGLINE=repuestos al instante
# STORE_LOGO_URL=/favicon.svg
# COLOR_PRIMARY=#c1121f
# COLOR_PRIMARY_HOVER=#e63946
# COLOR_ACCENT=#0d0d0d

# --- Panel Central (opcional — si no se definen, este deploy es "standalone"
# y corre con todas las funciones sin restricción de plan) ---
# Ver panel-central/README.md. PANEL_CENTRAL_URL es la URL del Panel Central
# (el servicio del super-admin, NO el de este catálogo). CLIENTE_API_KEY es
# la que te dio el super-admin al darte de alta como cliente ahí.
# PANEL_CENTRAL_URL=https://panel-central-tuempresa.onrender.com
# CLIENTE_API_KEY=la-api-key-que-te-dieron
