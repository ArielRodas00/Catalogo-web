# Dependencias (se reinstalan con npm install)
node_modules/

# Variables de entorno (contiene contraseñas)
.env

# Archivos del sistema
.DS_Store
Thumbs.db

# Logs
*.log

# Gestor de paquetes: el proyecto usa npm (ver README). No versionar artefactos de pnpm.
pnpm-lock.yaml
pnpm-workspace.yaml

# Imagenes subidas via Multer (contenido de usuario, no código)
public/uploads/*
!public/uploads/.gitkeep

# Scripts/archivos temporales de scripting/depuración (ej. capturas con Playwright)
_tmp-*